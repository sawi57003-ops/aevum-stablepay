pragma solidity ^0.8.20;

import {Script, console} from "forge-std/Script.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {StablePayEscrow} from "../src/StablePayEscrow.sol";

/// @notice Deploy StablePayEscrow to Aevum testnet (chain 44005).
/// @dev Usage:
///   forge script script/Deploy.s.sol --rpc-url https://rpc-test.qday.info \
///     --broadcast --keystore ~/.wallets/burn/keystore.json \
///     --password-file ~/.wallets/burn/.password
///   The script writes the deployed address to `deployments/aevum-testnet.json`
///   and to `app/config.js` (used by the static demo UI).
contract Deploy is Script {
    /// @notice tUSD8 on Aevum testnet — verified on-chain 16 Nov 2026
    ///         (name/symbol/decimals/totalSupply via eth_call).
    address public constant TUSD8 = 0x456569838f1d43009A91ebA4263147Afd7233483;

    /// @notice Aevum testnet chain id.
    uint256 public constant CHAIN_ID = 44005;

    function run() external {
        require(block.chainid == CHAIN_ID, "Deploy: wrong chain, expected Aevum testnet 44005");

        vm.startBroadcast();
        StablePayEscrow escrow = new StablePayEscrow(IERC20(TUSD8));
        vm.stopBroadcast();

        console.log("StablePayEscrow deployed at:", address(escrow));
        console.log("tUSD8 token:", TUSD8);
        console.log("deployer:", msg.sender);

        string memory json = string.concat(
            "{\n",
            '  "network": "Aevum testnet",\n',
            '  "chainId": 44005,\n',
            '  "rpc": "https://rpc-test.qday.info",\n',
            '  "explorer": "https://explorer-test.qday.info",\n',
            '  "tUSD8": "',
            vm.toString(TUSD8),
            '",\n',
            '  "escrow": "',
            vm.toString(address(escrow)),
            '",\n',
            '  "deployer": "',
            vm.toString(msg.sender),
            '"\n',
            "}\n"
        );
        vm.writeFile("deployments/aevum-testnet.json", json);

        string memory js = string.concat(
            "// Auto-generated by `forge script script/Deploy.s.sol`. Do not edit by hand.\n",
            "window.STABLEPAY_CONFIG = {\n",
            '  chainId: 44005,\n',
            '  rpc: "https://rpc-test.qday.info",\n',
            '  explorer: "https://explorer-test.qday.info",\n',
            '  tUSD8: "',
            vm.toString(TUSD8),
            '",\n',
            '  escrow: "',
            vm.toString(address(escrow)),
            '"\n',
            "};\n"
        );
        vm.writeFile("app/config.js", js);
    }
}
